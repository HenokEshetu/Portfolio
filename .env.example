# Contact form delivery (https://resend.com — free tier is enough).
# Without this the form returns an honest error instead of pretending to send.
RESEND_API_KEY=

# Optional. Defaults to Resend's shared sender until you verify your own domain.
CONTACT_FROM_EMAIL="Portfolio <onboarding@resend.dev>"

# Optional. Defaults to the address in content/profile.ts.
CONTACT_TO_EMAIL=
